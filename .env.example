# Contact form delivery (src/app/api/contact/route.ts).
# Without RESEND_API_KEY and CONTACT_FROM_EMAIL the endpoint returns 503 and the
# form tells the visitor to email directly — it never reports a false success.

# https://resend.com/api-keys
RESEND_API_KEY=

# Must be an address on a domain verified in Resend, e.g. website@avlokai.com
CONTACT_FROM_EMAIL=

# Optional. Defaults to company.email (hello@avlokai.com) when unset.
CONTACT_TO_EMAIL=
